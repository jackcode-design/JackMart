# Copy to .env (git-ignored) or export as environment variables. Never commit real secrets.
# Database (H2 embedded default; server mode example below)
DB_URL=jdbc:h2:./data/jackmart;DB_CLOSE_DELAY=-1
# H2 server mode example: jdbc:h2:tcp://localhost/~/jackmart
DB_USER=sa
DB_PASSWORD=
# Chatbot
AI_CHATBOT_PROVIDER=mock
# GEMINI_API_KEY must come from environment only, never committed. Required only if AI_CHATBOT_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_API_TIMEOUT_MS=8000
# Sessions
SESSION_TIMEOUT_MINUTES=30
